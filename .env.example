# Local PostgreSQL; Neon users can use the pooled URL here and direct URL below for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forma?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/forma?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
WHATSAPP_GRAPH_API_VERSION="v27.0"
# Development-only seed credentials. Change these for any shared environment.
DEMO_OWNER_EMAIL="owner@example.test"
DEMO_OWNER_PASSWORD="change-this-local-demo-password"
