{
  "name": "gym-management-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c green,blue,magenta \"vite\" \"tsx watch server/src/index.ts\" \"tsx watch server/src/worker.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:worker": "tsx watch server/src/worker.ts",
    "start": "node dist-server/server/src/index.js",
    "start:worker": "node dist-server/server/src/worker.js",
    "build": "npm run db:generate && tsc -b && tsc --project tsconfig.server.json && vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test server/src/domain.test.ts server/src/tenant.integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "1.75.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.2.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.25.12": true,
    "@prisma/client@7.10.1": true
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.2"
    }
  }
}
